{
  "name": "genpark-agentic-commerce-cross-border-letter-of-credit-discrepancy-curator-skill",
  "version": "1.0.0",
  "title": "Cross-Border Letter of Credit (LC) Discrepancy & UCP 600 Curator Skill",
  "description": "International trade UCP 600 documentary letter of credit (LC) compliance auditing, bill of lading discrepancy detection, and automated swift amendment generator. Built for GenPark (https://www.genpark.ai).",
  "homepage": "https://www.genpark.ai",
  "linkedin": "https://www.linkedin.com/company/92955550",
  "category": "agentic-commerce",
  "topics": [
    "letter-of-credit",
    "ucp600",
    "trade-finance",
    "bill-of-lading",
    "cross-border-procurement",
    "agentic-commerce",
    "model-context-protocol",
    "genpark"
  ],
  "tools": [
    {
      "name": "audit_lc_shipping_documents",
      "description": "Compare commercial invoice, ocean bill of lading, and certificate of origin against Letter of Credit terms to identify documentary discrepancies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lc_number": {
            "type": "string"
          },
          "lc_latest_shipment_date": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "bl_on_board_date": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "lc_amount_usd": {
            "type": "number"
          },
          "invoice_amount_usd": {
            "type": "number"
          },
          "tolerance_pct": {
            "type": "number",
            "description": "e.g. 5.0 for 5% tolerance"
          },
          "is_clean_bill_of_lading": {
            "type": "boolean"
          }
        },
        "required": [
          "lc_number",
          "lc_latest_shipment_date",
          "bl_on_board_date",
          "lc_amount_usd",
          "invoice_amount_usd",
          "is_clean_bill_of_lading"
        ]
      }
    },
    {
      "name": "generate_swift_mt707_amendment_request",
      "description": "Draft formal SWIFT MT707 message to advise issuing bank of required LC clause amendments prior to document presentation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lc_number": {
            "type": "string"
          },
          "issuing_bank_swift": {
            "type": "string"
          },
          "requested_latest_shipment_date": {
            "type": "string"
          },
          "amendment_reason": {
            "type": "string"
          }
        },
        "required": [
          "lc_number",
          "issuing_bank_swift",
          "requested_latest_shipment_date",
          "amendment_reason"
        ]
      }
    }
  ]
}